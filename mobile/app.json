{
  "expo": {
    "name": "Confia+",
    "slug": "confia-plus-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita que o Confia+ use o microfone para transcrever seu relato.",
          "speechRecognitionPermission": "Permita que o Confia+ reconheça sua fala para transcrever seu relato."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.confiamais.mobile"
    },
    "android": {
      "package": "net.confiamais.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "confiamais"
  }
}
